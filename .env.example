# Copy this file to .env and fill with real values before running in dev or production

# ---------- Backend ----------
# MongoDB connection string (Atlas / Railway)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/mydb?retryWrites=true&w=majority

# JWT secret used to sign auth tokens (use a long random string)
JWT_SECRET=change_this_to_a_strong_random_value

# Origin allowed by the backend CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Port the backend listens on (optional, defaults in code)
PORT=4000

# ---------- Frontend (build-time / Vite) ----------
# API base URL the frontend will call
VITE_API_BASE_URL=http://localhost:4000/api

# Socket server URL (for realtime)
VITE_SOCKET_URL=http://localhost:4000

# ---------- Optional / Hosting helpers ----------
# Railway / provider environment names (optional)
RAILWAY_ENVIRONMENT_NAME=
RAILWAY_PUBLIC_DOMAIN=

# NODE environment
NODE_ENV=development
