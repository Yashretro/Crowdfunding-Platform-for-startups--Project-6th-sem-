# MongoDB Atlas Connection URI Template
# 
# Replace the placeholders with your Atlas credentials:
# <username>    = Your Atlas DB user (e.g., kickscale_admin)
# <password>    = Your Atlas DB user password (use URI-encoded version if special chars)
# <cluster>     = Your cluster subdomain (e.g., cluster0.abcd1)
# 
# Example filled in:
# mongodb+srv://kickscale_admin:MyP%40ssw0rd@cluster0.abcd1.mongodb.net/kickscale?retryWrites=true&w=majority
#
# DO NOT commit this file with real credentials to git!
# Add .env.mongodb to .gitignore if you populate it with real values.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kickscale?retryWrites=true&w=majority

# Example with all placeholders shown:
# MONGODB_URI=mongodb+srv://kickscale_admin:your_secure_password@cluster0.abcd1.mongodb.net/kickscale?retryWrites=true&w=majority
